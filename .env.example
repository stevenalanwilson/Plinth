# Server
ANTHROPIC_API_KEY=sk-ant-your-key-here
PORT=3001

# Restrict API requests to this origin (defaults to http://localhost:5173 in dev)
CORS_ORIGIN=http://localhost:5173

# Postgres connection for stored albums (permalinks). Required in production.
# Docker Compose sets this itself. Outside Docker, either leave it unset to keep albums in memory
# (lost on restart), or run `docker compose up db` and use:
# DATABASE_URL=postgres://plinth:plinth@localhost:5432/plinth

# The address people reach the app on, used for the link preview cards of shared album pages.
# Link previews need absolute URLs. Set it in production; it is not needed for local development.
# PUBLIC_URL=https://plinth.example

# How many proxies sit between visitors and the server. The rate limits count requests by visitor
# address, which behind a proxy comes from X-Forwarded-For. Defaults to 1 in production (Railway is
# one proxy away) and 0 otherwise. Too low and everyone shares one limit; too high and a visitor can
# fake their address. Only a whole number is accepted.
# TRUST_PROXY=1

# Contact sent in the MusicBrainz User-Agent, as their API etiquette asks (optional)
MUSICBRAINZ_CONTACT=you@example.com

# Client (Vite uses VITE_ prefix)
VITE_API_URL=http://localhost:3001

# Footer links (optional — omit to hide the link)
VITE_MONZO_URL=https://monzo.me/your-username
VITE_FEEDBACK_EMAIL=you@example.com
